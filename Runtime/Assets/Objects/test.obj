# Crate with multiple materials
mtllib Assets/Objects/container.mtl

# Vertices (v x y z)
v -1.0 -1.0 -1.0  # 1
v  1.0 -1.0 -1.0  # 2
v  1.0  1.0 -1.0  # 3
v -1.0  1.0 -1.0  # 4
v -1.0 -1.0  1.0  # 5
v  1.0 -1.0  1.0  # 6
v  1.0  1.0  1.0  # 7
v -1.0  1.0  1.0  # 8

# Texture coordinates (vt u v)
vt 0.0 0.0  # 1
vt 1.0 0.0  # 2
vt 1.0 1.0  # 3
vt 0.0 1.0  # 4

# Normals (vn x y z)
vn  0.0  0.0  1.0  # 1 (front)
vn  0.0  0.0 -1.0  # 2 (back)
vn  1.0  0.0  0.0  # 3 (right)
vn -1.0  0.0  0.0  # 4 (left)
vn  0.0  1.0  0.0  # 5 (top)
vn  0.0 -1.0  0.0  # 6 (bottom)

# ========== FRONT FACE (Red) ==========
usemtl RedMaterial
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1

# ========== BACK FACE (Blue) ==========
usemtl BlueMaterial
f 1/1/2 4/2/2 3/3/2
f 1/1/2 3/3/2 2/4/2

# ========== RIGHT FACE (Green) ==========
usemtl GreenMaterial
f 2/1/3 6/2/3 7/3/3
f 2/1/3 7/3/3 3/4/3

# ========== LEFT FACE (Yellow) ==========
usemtl YellowMaterial
f 1/1/4 5/2/4 8/3/4
f 1/1/4 8/3/4 4/4/4

# ========== TOP FACE (Purple) ==========
usemtl PurpleMaterial
f 4/1/5 8/2/5 7/3/5
f 4/1/5 7/3/5 3/4/5

# ========== BOTTOM FACE (Orange) ==========
usemtl OrangeMaterial
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6